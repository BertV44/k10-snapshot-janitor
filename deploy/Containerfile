# =============================================================================
# COMMUNITY TOOL - NOT SUPPORTED BY VEEAM
#   Image of an independent project, with no affiliation with Veeam Software.
#   Provided without any warranty. The tool it carries deletes backups
#   permanently.
# =============================================================================
# Runtime image for k10-snapshot-janitor.sh
# UBI9-minimal base + bash + jq + the oc client (which includes kubectl)
#
# Build (podman):
#   podman build -t k10-snapshot-janitor:1.0.0 -f deploy/Containerfile .
#   The context must be the repository root: the COPY below takes
#   bin/k10-snapshot-janitor.sh.
#
# In-cluster OpenShift build:
#   oc -n kasten-io new-build --binary --name=k10-snapshot-janitor --strategy=docker
#   oc -n kasten-io start-build k10-snapshot-janitor --from-dir=. --follow
#   -> image-registry.openshift-image-registry.svc:5000/kasten-io/k10-snapshot-janitor:latest
#
# Without building: any community image carrying kubectl + jq works too. This
# project's documentation uses "oc" throughout; if the chosen image only ships
# kubectl, the script detects it on its own, and "--cli kubectl" is only there
# to force the choice.
# =============================================================================
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Provenance: these labels follow the image into any registry it is pushed to,
# where the README and the NOTICE do not.
LABEL org.opencontainers.image.title="k10-snapshot-janitor" \
      org.opencontainers.image.description="Community housekeeping tool for stale Veeam Kasten snapshots. Deletes backup data. Not a Veeam product, not supported by Veeam." \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="Independent community project, not affiliated with Veeam Software" \
      org.opencontainers.image.source="https://github.com/BertV44/k10-snapshot-janitor"

ARG OC_VERSION=stable-4.16
ARG TARGETARCH=amd64

LABEL name="k10-snapshot-janitor" \
      version="1.0.0" \
      summary="Retires Veeam Kasten snapshots past an age threshold" \
      maintainer="TAM EMEA"

# coreutils-single is explicit rather than assumed: the script calls date,
# mktemp, rm, mkdir, wc, tr, cat, cp, mv, tee, sleep and basename.
RUN microdnf -y install bash jq coreutils-single tar gzip ca-certificates shadow-utils \
    && microdnf -y clean all \
    && rm -rf /var/cache/yum

# oc client: fetched from the OpenShift mirror.
# In an air-gapped environment, replace with a COPY from a local artifact:
#   COPY oc /usr/local/bin/oc
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) ARCH_PATH="" ;; \
      arm64) ARCH_PATH="arm64/" ;; \
      *)     ARCH_PATH="" ;; \
    esac; \
    curl -sSfL "https://mirror.openshift.com/pub/openshift-v4/${ARCH_PATH}clients/ocp/${OC_VERSION}/openshift-client-linux.tar.gz" \
      -o /tmp/oc.tgz; \
    tar -xzf /tmp/oc.tgz -C /usr/local/bin oc kubectl; \
    rm -f /tmp/oc.tgz; \
    chmod 0755 /usr/local/bin/oc /usr/local/bin/kubectl; \
    oc version --client

# In production the script is mounted from a ConfigMap; the copy below serves
# manual runs and image testing.
COPY bin/k10-snapshot-janitor.sh /opt/janitor/k10-snapshot-janitor.sh
RUN chmod 0555 /opt/janitor/k10-snapshot-janitor.sh

# Arbitrary UID: OpenShift assigns one from the namespace range.
USER 1001
WORKDIR /tmp
ENV HOME=/tmp

ENTRYPOINT ["/opt/janitor/k10-snapshot-janitor.sh"]
CMD ["--help"]
